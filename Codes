  line <- readLines(con, n = 1)
  if (length(line) == 0) break
  if (startsWith(line, cdk12_id)) {
    cdk12_line <- line
    break
  }
}

close(con)


cdk12_values <- strsplit(cdk12_line[[1]], "\t")[[1]]
cdk12_expr <- as.numeric(cdk12_values[-c(1, 2)]) 
cdk12_df <- data.frame(Sample = sample_ids, Expression = cdk12_expr)


head(cdk12_df)
library(data.table)


pheno <- fread("TCGA_phenotype_denseDataOnlyDownload.tsv.gz")
head(pheno)



cdk12_df$Sample <- gsub("\\.", "-", cdk12_df$Sample)


merged_df <- merge(cdk12_df, pheno, by.x = "Sample", by.y = "sample")

ggplot(merged_df, aes(x = `_primary_disease`, y = Expression)) +
  geom_boxplot(outlier.size = 0.4, fill = "skyblue") +
