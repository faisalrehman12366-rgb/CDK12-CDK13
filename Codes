    axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1),
    plot.title = element_text(face = "bold")
  ) +
  labs(
    title = "CDK12 Expression Across TCGA Primary Diseases",
    x = "Primary Disease",
    y = "CDK12 Expression (TPM or log2TPM)"
  )

